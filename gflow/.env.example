# Copiar a .env (ignorado por git). gflow lo lee desde el directorio actual.

# Las imágenes/vídeos generados se quedan dentro de gflow/output/ (ignorado por git).
GFLOW_CLI_OUTPUT_DIR=./output

# Servidor MCP sin herramientas que gastan créditos (también cubre `gflow serve`).
GFLOW_MCP_NO_SPEND=1

# Solo si estás detrás de un proxy:
# GFLOW_CLI_BROWSER_PROXY=http://127.0.0.1:7890

# NO pongas GFLOW_CLI_HOME dentro del repo: ahí vive la sesión de Google.
